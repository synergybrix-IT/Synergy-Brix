# Public site origin used for sitemap generation. Canonical tags always use https://www.synergybrix.com.
NEXT_PUBLIC_SITE_URL=https://www.synergybrix.com

# Resend API key for sending project inquiry emails from the serverless API.
# Generate this in your Resend dashboard: https://resend.com/api-keys
RESEND_API_KEY=

# Sender address for enquiry emails. Must be a verified Resend sender/domain.
RESEND_FROM_EMAIL=

# The business email address that receives project inquiry notifications.
CONTACT_EMAIL=
